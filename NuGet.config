<configuration>

  <!--
    Pinned so restore works the same on any machine, even one with a corporate
    or leftover feed configured globally.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
