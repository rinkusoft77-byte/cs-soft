<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Framework, language version and nullability come from Directory.Build.props
    in the repository root.
  -->

  <PropertyGroup>
    <AssemblyName>VisionAssist</AssemblyName>
    <RootNamespace>VisionAssist</RootNamespace>
    <Version>2.0.0</Version>
    <Product>VisionAssist</Product>
    <Description>Visibility and readability plugin for a self-hosted CS2 server.</Description>

    <!-- Required so CounterStrikeSharp can load the plugin into its own ALC. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.305">
      <!-- The API assembly is provided by the server at runtime. -->
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Resolves the deploy folder from whichever property was set. Done at
    evaluation time rather than inside a target, because a target's Condition
    is checked before its dependencies get a chance to set anything.
  -->
  <PropertyGroup>
    <CS2PluginsPath Condition="'$(CS2PluginsPath)' == '' And '$(CS2ServerPath)' != ''">$(CS2ServerPath)/game/csgo/addons/counterstrikesharp/plugins</CS2PluginsPath>
    <PluginDeployPath Condition="'$(CS2PluginsPath)' != ''">$(CS2PluginsPath)/$(AssemblyName)</PluginDeployPath>
  </PropertyGroup>

  <!--
    Copies the build output into the server's plugin folder. Skipped entirely
    when no path is configured, so a fresh clone builds without any setup.
  -->
  <Target Name="DeployToServer"
          AfterTargets="Build"
          Condition="'$(PluginDeployPath)' != ''">

    <ItemGroup>
      <PluginOutput Include="$(TargetDir)**/*.dll;$(TargetDir)**/*.json;$(TargetDir)**/*.pdb" />
    </ItemGroup>

    <MakeDir Directories="$(PluginDeployPath)" />

    <Copy SourceFiles="@(PluginOutput)"
          DestinationFiles="@(PluginOutput->'$(PluginDeployPath)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          ContinueOnError="WarnAndContinue" />

    <Message Importance="high" Text="VisionAssist deployed to $(PluginDeployPath)" />
  </Target>

</Project>
